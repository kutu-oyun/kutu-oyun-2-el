# ===========================================
# BACKEND - Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# cp .env.example .env
# ===========================================

# --- Sunucu ---
PORT=4000
NODE_ENV=development

# Frontend adresi (CORS ve PayTR callback için)
# Lokal: http://localhost:3000
# Canlı: https://kutuly.com
FRONTEND_URL=http://localhost:3000

# --- Veritabanı (Google Cloud SQL - MySQL) ---
# Cloud SQL bağlantı formatı:
# mysql://KULLANICI:SIFRE@/VERITABANI?host=/cloudsql/PROJE_ID:REGION:INSTANCE_ADI
# Örnek (Unix socket - Cloud Run'dan):
# DATABASE_URL="mysql://kutu_user:SIFRENIZ@/kutu_db?host=/cloudsql/my-project:europe-west1:kutu-mysql"
# Örnek (TCP - yerel geliştirme):
# DATABASE_URL="mysql://kutu_user:SIFRENIZ@127.0.0.1:3306/kutu_db"
DATABASE_URL="mysql://user:password@localhost:3306/kutu_db"

# --- JWT (Auth) ---
JWT_SECRET=uzun-ve-guvenli-rastgele-string-en-az-32-karakter
JWT_EXPIRES_IN=24h

# --- Google Cloud Storage (resimler, belgeler) ---
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=kutuly-uploads

# --- Firebase Admin (backend doğrulama) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- PayTR (ödeme) ---
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
